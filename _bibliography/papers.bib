@unpublished{wang_glp1_demand_2026,
	selected = {true},
	abbr = {JMP},
	title = {The {Effects} of {GLP-1} {Medications} on {Household} {Food} {Demand}},
	author = {Wang, Xuejian and Balagtas, Joseph},
	year = {2026},
	additional_info = {Job market paper. In preparation.},
	abstract = {Some of the first product-level evidence on how GLP-1 medications change household food demand. A GLP-1 survey inside the NielsenIQ Consumer Panel links each household's adoption to its grocery purchases; harmonized Nutrition Facts data attach calories and nutrients to every product. Matched staggered difference-in-differences estimates show that spending falls more than calories: households buy cheaper calories, not fewer. The basket shrinks but does not get healthier -- fiber, fat, protein, and sodium all fall at adoption, while sugar does not.},
}

